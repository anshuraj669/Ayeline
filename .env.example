# Copy to .env.local for development, or set these on your host.

# Postgres for the shared service desk, RSVPs and report photos. Required in production.
# Without it, development stores everything in .data/ instead.
DATABASE_URL=postgres://postgres:dev@localhost:5432/ayeline

# PIN for the City crew dispatch board. Required in production; development defaults to 1234.
STAFF_PIN=

# Set to no-verify only if your database's SSL certificate can't be verified.
# DATABASE_SSL=no-verify

# Most connections each app instance opens (default 5).
# DATABASE_POOL_MAX=5
